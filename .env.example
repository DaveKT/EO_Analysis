# Copy to .env and fill in. Never commit .env.

# OpenRouter API key — https://openrouter.ai/keys
# This exact name is the only one read; there is no fallback to other names.
eo_openrouterkey=

# Model used for the full-corpus sweep (Phase 3/5).
EO_MODEL=openai/gpt-oss-120b

# Paths (optional; defaults shown).
# EO_DB_PATH=data/eo.db
# EO_RAW_DIR=data/raw

# Bounded concurrency for the extraction runner (Phase 3).
# EO_CONCURRENCY=8

# Output cap per call. Generous on purpose: a truncated response is invalid,
# and v1's max_tokens=200 silently cut 29 summaries mid-clause.
# EO_MAX_TOKENS=8000
